{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Deploy to Cloudflare config. It names the database but not its id, so a deploy creates
  // the database. No account id, resource id, or secret belongs in git.
  "name": "hivepantry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.md"], "fallthrough": true }],
  // Each var has a default, so the deploy form needs only ADMIN_TOKEN. The deploy script sets
  // GIT_SHA and, when OWNER_EMAIL is a build variable, the Cloudflare Access vars. PANTRY_TZ is
  // the time zone until the first console sign-in, which stores the browser's zone.
  "vars": {
    "PANTRY_TZ": "UTC"
  },
  "secrets": { "required": ["ADMIN_TOKEN"] },
  // Limits ADMIN_TOKEN tries per IP. The namespace id is a number of our choice, not a resource
  // id, so a deploy needs nothing made first.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivepantry-db",
      "migrations_dir": "migrations"
    }
  ]
}
